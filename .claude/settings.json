{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/hooks/tdd-guard.sh"
          }
        ]
      },
      {
        "matcher": "Shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/hooks/shell-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'input=$(cat); echo \"$input\" | grep -qE \"\\\\$CLAUDE_TOOL_INPUT.*(rm[[:space:]]+-rf|git[[:space:]]+push[[:space:]]+--force|git[[:space:]]+reset[[:space:]]+--hard|DROP[[:space:]]+TABLE)\" && { echo \"BLOCKED: 위험한 명령어가 감지되었습니다\" >&2; exit 1; }; exit 0'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'input=$(cat); echo \"$(date +%F%T) | $CLAUDE_TOOL_INPUT\" >> \"${CLAUDE_PROJECT_DIR}/.claude/audit.log\"' || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if [ -f \"${CLAUDE_PROJECT_DIR}/scripts/token-report.js\" ]; then node \"${CLAUDE_PROJECT_DIR}/scripts/token-report.js\" \"$HOME/.claude/projects\"; fi' || true"
          }
        ]
      }
    ]
  }
}
